let search = "";

function fmtMoney(n) {
  if (n == null || Number.isNaN(n)) return "—";
  const sign = n > 0 ? "+" : "";
  return sign + "$" + Number(n).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
}
function fmtNum(n, d=2) {
  if (n == null || n === "" || Number.isNaN(Number(n))) return "—";
  return Number(n).toLocaleString(undefined, {minimumFractionDigits: d, maximumFractionDigits: d});
}
function fmtLiveMetric(n, d=2) {
  if (n == null || n === "" || Number.isNaN(Number(n))) return "n/a";
  return Number(n).toLocaleString(undefined, {minimumFractionDigits: d, maximumFractionDigits: d});
}
function cls(n) {
  if (n == null || Number.isNaN(n)) return "";
  return n > 0 ? "pos" : (n < 0 ? "neg" : "");
}

function renderSummary() {
  const p = DATA.portfolio;
  document.getElementById("modeBadge").textContent = DATA.mode;
  document.getElementById("genMeta").textContent =
    "Generated " + DATA.generated_hkt + " · last paper run " + (p.last_run_hkt || "—") +
    " · " + p.n_live + "/" + p.n_books + " books live";
  const sleeveEq = p.sleeve_equity_usd != null ? p.sleeve_equity_usd : p.equity_usd;
  const capDep = p.capital_deployed_usd != null ? p.capital_deployed_usd : (DATA.account_usd * p.n_books);
  const cells = [
    ["Sleeve equity", fmtMoney(sleeveEq), cls(sleeveEq - capDep)],
    ["Engine pool", fmtMoney(p.equity_usd), cls(p.equity_usd - DATA.account_usd)],
    ["Realized", fmtMoney(p.realized_usd), cls(p.realized_usd)],
    ["Unrealized", fmtMoney(p.unrealized_usd), cls(p.unrealized_usd)],
    ["Open pos", String(p.open_positions), ""],
    ["Books", p.n_live + " / " + p.n_books, ""],
    ["Per-book start", "$" + Number(DATA.capital_per_book_usd || DATA.account_usd).toLocaleString(), ""],
    ["Capital deployed", "$" + Number(capDep).toLocaleString(), ""],
  ];
  document.getElementById("summary").innerHTML = cells.map(([k,v,c]) =>
    `<div class="card"><div class="k">${k}</div><div class="v ${c}">${v}</div></div>`
  ).join("");
}

let portChart = null;
let booksVisible = true;

function fmtAxisTs(t) {
  try { return new Date(t).toLocaleString("en-HK", {timeZone: "Asia/Hong_Kong", month:"short", day:"numeric", hour:"2-digit", minute:"2-digit"}); }
  catch(e) { return t; }
}

function bookColor(i, n) {
  const h = Math.round((i * 360) / Math.max(n, 1));
  return `hsl(${h} 70% 62%)`;
}

/** Align book PnL onto master stamps: start_capital from era baseline, + PnL when known. */
function alignBookEquity(masterT, bookT, bookPnl, startCap) {
  const out = new Array(masterT.length).fill(startCap);
  if (!bookT || !bookT.length) return out;
  let j = 0;
  let last = null;
  for (let i = 0; i < masterT.length; i++) {
    const t = masterT[i];
    while (j < bookT.length && bookT[j] <= t) {
      last = bookPnl[j];
      j++;
    }
    out[i] = startCap + (last != null ? Number(last) : 0);
  }
  return out;
}

function renderPortChart() {
  const ctx = document.getElementById("portChart");
  const sleeveT = DATA.sleeve_equity_t && DATA.sleeve_equity_t.length ? DATA.sleeve_equity_t : DATA.equity_t;
  const sleeveV = DATA.sleeve_equity_v && DATA.sleeve_equity_v.length ? DATA.sleeve_equity_v : DATA.equity_v;
  if (!window.Chart || !sleeveT || !sleeveT.length) {
    ctx.parentElement.innerHTML = "<div class='meta'>No equity series yet (or Chart.js missing).</div>";
    return;
  }
  const perBook = DATA.capital_per_book_usd || DATA.account_usd || 10000;
  const nBooks = (DATA.books || []).length;
  const eraLbl = DATA.chart_era_label || "2026-10-06 HKT";
  document.getElementById("chartNote").textContent =
    "Baseline " + eraLbl + ": every book counts $" + Number(perBook).toLocaleString() +
    " from that day (flat until its ledger starts) so late opens do not jump portfolio. " +
    "Curves = start + live PnL. Thick line = sum of sleeves (~$" +
    Number(perBook * nBooks).toLocaleString() + " deployed). " +
    "Engine pool card is the legacy single $" + Number(DATA.account_usd).toLocaleString() +
    " account + aggregate PnL.";

  const labels = sleeveT.map(fmtAxisTs);
  const books = (DATA.books || []).slice().sort((a, b) => Math.abs(b.live_pnl||0) - Math.abs(a.live_pnl||0));
  const datasets = [];

  datasets.push({
    label: "Portfolio (sum of sleeves)",
    data: sleeveV,
    borderColor: "#59c2ff",
    backgroundColor: "rgba(89,194,255,0.10)",
    fill: false,
    tension: 0.15,
    pointRadius: 0,
    borderWidth: 3,
    yAxisID: "y1",
    order: 0,
  });

  books.forEach((b, i) => {
    const startCap = b.start_capital != null ? Number(b.start_capital) : perBook;
    datasets.push({
      label: b.name,
      data: alignBookEquity(sleeveT, b.equity_t, b.equity_v, startCap),
      borderColor: bookColor(i, books.length),
      backgroundColor: "transparent",
      fill: false,
      tension: 0.15,
      pointRadius: 0,
      borderWidth: 1,
      borderOpacity: 0.7,
      yAxisID: "y",
      order: 1,
      hidden: !booksVisible,
    });
  });

  if (portChart) portChart.destroy();
  portChart = new Chart(ctx, {
    type: "line",
    data: { labels, datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: "nearest", axis: "x", intersect: false },
      plugins: {
        legend: {
          display: true,
          position: "bottom",
          labels: {
            color: "#8b9bb4",
            boxWidth: 10,
            boxHeight: 10,
            font: { size: 9 },
            padding: 6,
          },
        },
        tooltip: {
          callbacks: {
            label: (c) => {
              const v = c.parsed.y;
              if (v == null || Number.isNaN(v)) return c.dataset.label + ": —";
              return c.dataset.label + ": $" + Number(v).toLocaleString(undefined, {maximumFractionDigits: 2});
            }
          }
        }
      },
      scales: {
        x: { ticks: { color: "#8b9bb4", maxTicksLimit: 8 }, grid: { color: "#2a3544" } },
        y: {
          position: "left",
          title: { display: true, text: "Book equity USD", color: "#8b9bb4", font: { size: 11 } },
          ticks: { color: "#8b9bb4" },
          grid: { color: "#2a3544" },
        },
        y1: {
          position: "right",
          title: { display: true, text: "Portfolio (sleeves) USD", color: "#59c2ff", font: { size: 11 } },
          ticks: { color: "#59c2ff" },
          grid: { drawOnChartArea: false },
        },
      }
    }
  });
}

function setAllBooksHidden(hidden) {
  booksVisible = !hidden;
  if (!portChart) return;
  portChart.data.datasets.forEach((ds, idx) => {
    if (idx === 0) return; // portfolio
    ds.hidden = hidden;
  });
  portChart.update();
  const btn = document.getElementById("btnToggleBooks");
  if (btn) {
    btn.textContent = hidden ? "Books off" : "Books on";
    btn.classList.toggle("active", !hidden);
  }
}

const COLS = [
  {key:"name", label:"Book", align:"left", group:"meta"},
  {key:"ticker", label:"Mkt", group:"meta"},
  {key:"tf", label:"TF", group:"meta"},
  {key:"bt_OOS_pf", label:"BT PF", group:"bt"},
  {key:"bt_OOS_sharpe", label:"BT Sharpe", group:"bt"},
  {key:"bt_OOS_trades", label:"BT n", group:"bt"},
  {key:"bt_wf", label:"WF", group:"bt"},
  {key:"bt_OOS_dd", label:"BT DD", group:"bt"},
  {key:"go_live_hkt", label:"Go-live", group:"live", sep:true},
  {key:"live_trades", label:"Live n", group:"live"},
  {key:"live_pf", label:"Live PF", group:"live"},
  {key:"live_sharpe", label:"Live Sharpe", group:"live"},
  {key:"live_realized", label:"Realized", group:"live"},
  {key:"live_unrealized", label:"Unreal", group:"live"},
  {key:"live_pnl", label:"Live PnL", group:"live"},
  {key:"live_equity", label:"Book eq", group:"live"},
  {key:"open_side", label:"Pos", group:"live"},
  {key:"last_signal", label:"Last sig", group:"live"},
];

function filteredBooks() {
  const q = search.trim().toLowerCase();
  let rows = DATA.books.slice();
  if (q) {
    rows = rows.filter(b =>
      (b.name||"").toLowerCase().includes(q) ||
      (b.ticker||"").toLowerCase().includes(q) ||
      (b.template||"").toLowerCase().includes(q) ||
      (b.strategy||"").toLowerCase().includes(q) ||
      (b.label||"").toLowerCase().includes(q)
    );
  }
  rows.sort((a,b) => {
    let av = a[sortKey], bv = b[sortKey];
    if (av == null) av = sortOrder === "asc" ? Infinity : -Infinity;
    if (bv == null) bv = sortOrder === "asc" ? Infinity : -Infinity;
    if (typeof av === "string") {
      const c = av.localeCompare(bv);
      return sortOrder === "asc" ? c : -c;
    }
    return sortOrder === "asc" ? (av - bv) : (bv - av);
  });
  return rows;
}

function renderBooks() {
  const thead = document.querySelector("#booksTable thead");
  const nMeta = COLS.filter(c => c.group === "meta").length;
  const nBt = COLS.filter(c => c.group === "bt").length;
  const nLive = COLS.filter(c => c.group === "live").length;
  const groupRow = `<tr class="group-row">
    <th class="group-meta" colspan="${nMeta}"></th>
    <th class="group-bt" colspan="${nBt}">Backtest OOS</th>
    <th class="group-live" colspan="${nLive}">Go-Live / live demo</th>
  </tr>`;
  const colRow = "<tr>" + COLS.map(c => {
    const cls = c.sep ? " class=\"sep-live\"" : "";
    const arrow = sortKey===c.key ? (sortOrder==='asc'?' ▲':' ▼') : '';
    return `<th data-k="${c.key}"${cls} style="text-align:${c.align||'right'}">${c.label}${arrow}</th>`;
  }).join("") + "</tr>";
  thead.innerHTML = groupRow + colRow;
  thead.querySelectorAll("th[data-k]").forEach(th => {
    th.onclick = () => {
      const k = th.dataset.k;
      if (sortKey === k) sortOrder = sortOrder === "asc" ? "desc" : "asc";
      else { sortKey = k; sortOrder = (k === "name" || k === "go_live_hkt") ? "asc" : "desc"; }
      renderBooks();
    };
  });
  const rows = filteredBooks();
  document.getElementById("bookCount").textContent = rows.length + " shown";
  const tbody = document.querySelector("#booksTable tbody");
  tbody.innerHTML = rows.map(b => {
    const sub = [b.template || b.strategy, b.bt_verdict ? ("BT " + b.bt_verdict) : null].filter(Boolean).join(" · ");
    return `<tr>
      <td><div class="name">${b.name}</div><div class="sub">${sub}</div></td>
      <td>${b.ticker || "—"}</td>
      <td>${b.tf || "—"}</td>
      <td>${fmtNum(b.bt_OOS_pf)}</td>
      <td>${fmtNum(b.bt_OOS_sharpe)}</td>
      <td>${b.bt_OOS_trades != null ? Math.round(b.bt_OOS_trades) : "—"}</td>
      <td>${b.bt_wf || "—"}</td>
      <td>${fmtNum(b.bt_OOS_dd, 0)}</td>
      <td class="sub sep-live">${b.go_live_hkt || "—"}</td>
      <td>${b.live_trades}</td>
      <td title="Profit factor from closed paper trades since go-live; n/a if &lt;5 trades or no losses">${fmtLiveMetric(b.live_pf)}</td>
      <td title="Annualised Sharpe from weekday daily book-equity changes since go-live; n/a until ≥20 days">${fmtLiveMetric(b.live_sharpe)}</td>
      <td class="${cls(b.live_realized)}">${fmtMoney(b.live_realized)}</td>
      <td class="${cls(b.live_unrealized)}">${fmtMoney(b.live_unrealized)}</td>
      <td class="${cls(b.live_pnl)}"><b>${fmtMoney(b.live_pnl)}</b></td>
      <td class="${cls((b.live_equity||0) - (b.start_capital||DATA.account_usd))}">${fmtMoney(b.live_equity)}</td>
      <td>${b.open_side || "flat"}</td>
      <td>${b.last_signal || "—"}</td>
    </tr>`;
  }).join("");
}

function renderSimpleTable(id, cols, rows, mapRow) {
  const el = document.getElementById(id);
  el.querySelector("thead").innerHTML = "<tr>" + cols.map(c => `<th>${c}</th>`).join("") + "</tr>";
  el.querySelector("tbody").innerHTML = rows.length
    ? rows.map(mapRow).join("")
    : `<tr><td colspan="${cols.length}" class="sub">None yet</td></tr>`;
}

function renderLists() {
  renderSimpleTable("posTable",
    ["Book","Side","Entry","Last","Unreal","Updated"],
    DATA.open_positions,
    p => `<tr>
      <td>${p.book}</td><td>${p.side}</td>
      <td>${fmtNum(p.entry, 4)}</td><td>${fmtNum(p.last_close, 4)}</td>
      <td class="${cls(p.unrealized_usd)}">${fmtMoney(p.unrealized_usd)}</td>
      <td class="sub">${p.updated_at || ""}</td></tr>`
  );
  renderSimpleTable("tradesTable",
    ["Book","Side","Exit","PnL","Reason"],
    DATA.recent_trades.slice(0, 40),
    t => `<tr>
      <td>${t.book}</td><td>${t.side}</td>
      <td class="sub">${t.exit_time || ""}</td>
      <td class="${cls(t.pnl_usd)}">${fmtMoney(t.pnl_usd)}</td>
      <td>${t.reason || ""}</td></tr>`
  );
  renderSimpleTable("sigTable",
    ["Book","Signal","Bar","Close","Recorded"],
    DATA.recent_signals.slice(0, 40),
    s => `<tr>
      <td>${s.book}</td><td>${s.signal}</td>
      <td class="sub">${s.bar_time || ""}</td>
      <td>${fmtNum(s.close, 4)}</td>
      <td class="sub">${s.recorded_at || ""}</td></tr>`
  );
}

document.getElementById("search").addEventListener("input", e => {
  search = e.target.value; renderBooks();
});

renderSummary();
renderPortChart();
renderBooks();
renderLists();

document.getElementById("btnToggleBooks").addEventListener("click", () => {
  setAllBooksHidden(booksVisible);
});
document.getElementById("btnBooksOff").addEventListener("click", () => setAllBooksHidden(true));
document.getElementById("btnBooksOn").addEventListener("click", () => setAllBooksHidden(false));
</script>
