<script>
/*! Algowise shared theme: system (prefers-color-scheme) default + manual light/dark/system. localStorage key: algowise-theme */
(function () {
  if (window.__ALGOWISE_THEME__) return;
  window.__ALGOWISE_THEME__ = true;
  var KEY = "algowise-theme";
  var MODES = ["system", "light", "dark"];
  var LABELS = { system: "System", light: "Light", dark: "Dark" };
  var ICONS = {
    system: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 20h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 16v4" stroke="currentColor" stroke-width="1.8"/></svg>',
    light: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8l1.8-1.8M18 6l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
    dark: '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M18 13.5A7.5 7.5 0 0 1 10.5 6 6 6 0 1 0 18 13.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>'
  };

  function systemDark() {
    try { return window.matchMedia("(prefers-color-scheme: dark)").matches; } catch (e) { return true; }
  }
  function readMode() {
    try {
      var m = localStorage.getItem(KEY);
      if (MODES.indexOf(m) >= 0) return m;
    } catch (e) {}
    return "system";
  }
  function resolved(mode) {
    if (mode === "light") return "light";
    if (mode === "dark") return "dark";
    return systemDark() ? "dark" : "light";
  }
  function apply(mode) {
    var m = MODES.indexOf(mode) >= 0 ? mode : "system";
    var r = resolved(m);
    document.documentElement.setAttribute("data-theme", m);
    document.documentElement.setAttribute("data-theme-resolved", r);
    try { localStorage.setItem(KEY, m); } catch (e) {}
    var btn = document.getElementById("algowise-theme-btn");
    if (btn) {
      btn.innerHTML = ICONS[m] || ICONS.system;
      btn.setAttribute("aria-label", "Theme: " + (LABELS[m] || m) + " (click to cycle)");
      btn.title = "Theme: " + (LABELS[m] || m) + " · click → light / dark / system";
    }
    var menu = document.getElementById("algowise-theme-menu");
    if (menu) {
      Array.prototype.forEach.call(menu.querySelectorAll("[data-mode]"), function (el) {
        el.setAttribute("aria-checked", el.getAttribute("data-mode") === m ? "true" : "false");
      });
    }
  }
  function nextMode(cur) {
    var i = MODES.indexOf(cur);
    return MODES[(i + 1) % MODES.length];
  }
  function ensureCss() {
    if (document.getElementById("algowise-theme-css")) return;
    var css = document.createElement("style");
    css.id = "algowise-theme-css";
    css.textContent = [
      'html[data-theme-resolved="light"]{',
      '--bg:#f0f3f7;--card:#ffffff;--panel:#ffffff;--text:#152033;--muted:#5b6b82;--accent:#2563eb;--ok:#059669;--bad:#dc2626;--warn:#d97706;',
      '--border:#d5dde8;--header-bg:#e8eef7;--code-bg:#e8eef5;--surface:#e8eef5;--chip-bg:#e8eef7;color-scheme:light;}',
      'html[data-theme-resolved="dark"]{',
      '--bg:#0f1419;--card:#1a2332;--panel:#151922;--text:#e7ecf3;--muted:#8b9bb4;--accent:#3d8bfd;--ok:#3dd68c;--bad:#f87171;--warn:#fbbf24;',
      '--border:#243044;--header-bg:#152033;--code-bg:#0b1220;--surface:#0b1220;--chip-bg:#1a2f4a;color-scheme:dark;}',
      'html[data-theme-resolved="light"] body,html[data-theme-resolved="dark"] body{background:var(--bg)!important;color:var(--text)!important;}',
      '#algowise-theme-root{position:fixed;top:12px;right:12px;z-index:99999;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;}',
      '#algowise-theme-btn{width:38px;height:38px;border-radius:11px;border:1px solid var(--border,#243044);background:var(--card,#1a2332);color:var(--text,#e7ecf3);',
      'display:inline-flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.18);padding:0;}',
      '#algowise-theme-btn:hover{border-color:var(--accent,#3d8bfd);}',
      '#algowise-theme-menu{display:none;position:absolute;right:0;top:44px;min-width:132px;background:var(--card,#1a2332);border:1px solid var(--border,#243044);',
      'border-radius:12px;padding:6px;box-shadow:0 10px 30px rgba(0,0,0,.28);}',
      '#algowise-theme-root.open #algowise-theme-menu{display:block;}',
      '#algowise-theme-menu button{display:flex;width:100%;align-items:center;gap:8px;border:0;background:transparent;color:var(--text,#e7ecf3);',
      'padding:8px 10px;border-radius:8px;cursor:pointer;font-size:13px;font-weight:600;text-align:left;}',
      '#algowise-theme-menu button:hover{background:var(--surface,#0b1220);}',
      '#algowise-theme-menu button[aria-checked="true"]{color:var(--accent,#3d8bfd);}',
      '@media (max-width:640px){#algowise-theme-root{top:8px;right:8px;}#algowise-theme-btn{width:34px;height:34px;}}'
    ].join("");
    document.head.appendChild(css);
  }
  function ensureUi() {
    if (document.getElementById("algowise-theme-root")) return;
    var root = document.createElement("div");
    root.id = "algowise-theme-root";
    root.innerHTML =
      '<button type="button" id="algowise-theme-btn" aria-haspopup="menu" aria-expanded="false"></button>' +
      '<div id="algowise-theme-menu" role="menu">' +
      '<button type="button" role="menuitemradio" data-mode="light" aria-checked="false">' + ICONS.light + " Light</button>" +
      '<button type="button" role="menuitemradio" data-mode="dark" aria-checked="false">' + ICONS.dark + " Dark</button>" +
      '<button type="button" role="menuitemradio" data-mode="system" aria-checked="false">' + ICONS.system + " System</button>" +
      "</div>";
    document.body.appendChild(root);
    var btn = document.getElementById("algowise-theme-btn");
    var menu = document.getElementById("algowise-theme-menu");
    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      var open = root.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    menu.addEventListener("click", function (e) {
      var t = e.target.closest("[data-mode]");
      if (!t) return;
      apply(t.getAttribute("data-mode"));
      root.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    });
    document.addEventListener("click", function () {
      root.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    });
    btn.addEventListener("contextmenu", function (e) {
      e.preventDefault();
      apply(nextMode(readMode()));
    });
  }
  function boot() {
    ensureCss();
    ensureUi();
    apply(readMode());
  }
  try {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
      if (readMode() === "system") apply("system");
    });
  } catch (e) {}
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();

</script>
